@@ -342,3 +342,39 @@ func replaceOAuthSessionStoreForTest(t *testing.T, store *oauthSessionStore) {
 		oauthSessions = original
 	})
 }
+
+func TestOAuthCompletionSurvivesSuspendedBrowser(t *testing.T) {
+	for _, finish := range []string{"Complete", "CompleteProvider", "finishOAuth"} {
+		t.Run(finish, func(t *testing.T) {
+			store := newOAuthSessionStore(oauthSessionTTL)
+			store.Register("suspended-browser", "codex")
+			switch finish {
+			case "Complete":
+				store.Complete("suspended-browser")
+			case "CompleteProvider":
+				store.CompleteProvider("codex", oauthSessionSourceBuiltin)
+			case "finishOAuth":
+				if err := store.finishOAuth("suspended-browser", func() error { return nil }); err != nil {
+					t.Fatal(err)
+				}
+			}
+			// A browser can suspend for the entire advertised T3 enrollment lifetime.
+			store.mu.Lock()
+			store.purgeExpiredLocked(time.Now().Add(oauthSessionTTL - time.Second))
+			store.mu.Unlock()
+			result, ok := store.Get("suspended-browser")
+			if !ok || !result.Completed {
+				t.Fatal("saved credentials lost their completion result while the browser was suspended")
+			}
+			if store.Cancel("suspended-browser") {
+				t.Fatal("completed enrollment must not be cancelled")
+			}
+			store.mu.Lock()
+			store.purgeExpiredLocked(time.Now().Add(oauthSessionTTL + time.Second))
+			store.mu.Unlock()
+			if _, ok := store.Get("suspended-browser"); ok {
+				t.Fatal("completion result retained indefinitely")
+			}
+		})
+	}
+}
