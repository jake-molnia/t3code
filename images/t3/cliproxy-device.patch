+
+// attachCancel stops a device authorization as soon as its session is cancelled.
+func (s *oauthSessionStore) attachCancel(state string, cancel context.CancelFunc) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	session, ok := s.sessions[state]
+	if !ok || session.Completed || session.Status != "" {
+		cancel()
+		return
+	}
+	session.Cancel = cancel
+	s.sessions[state] = session
+}
+
+// finishOAuth serializes credential persistence with cancellation for every login flow.
+func (s *oauthSessionStore) finishOAuth(state string, save func() error) error {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	session, ok := s.sessions[state]
+	if !ok || session.Completed || session.Status != "" || time.Now().After(session.ExpiresAt) {
+		return errOAuthSessionNotPending
+	}
+	if err := save(); err != nil {
+		return err
+	}
+	session.Completed = true
+	session.Cancel = nil
+	session.ExpiresAt = time.Now().Add(s.completedTTL)
+	s.sessions[state] = session
+	return nil
+}
