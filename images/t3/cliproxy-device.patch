+	coreauth "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/auth"
+)
+
+type deviceTransport func(*http.Request) (*http.Response, error)
+
+func (f deviceTransport) RoundTrip(r *http.Request) (*http.Response, error) { return f(r) }
+
+func TestCodexDeviceManagementCancellation(t *testing.T) {
+	old := http.DefaultTransport
+	defer func() { http.DefaultTransport = old }()
+	polling := make(chan struct{})
+	cancelled := make(chan struct{})
+	http.DefaultTransport = deviceTransport(func(r *http.Request) (*http.Response, error) {
+		if strings.HasSuffix(r.URL.Path, "/usercode") {
+			return &http.Response{StatusCode: 200, Body: io.NopCloser(strings.NewReader(`{"device_auth_id":"secret-device-id","user_code":"ABCD-EFGH","interval":1}`)), Header: make(http.Header)}, nil
+		}
+		close(polling)
+		<-r.Context().Done()
+		close(cancelled)
+		return nil, r.Context().Err()
+	})
+	handler := NewHandlerWithoutConfigFilePath(&config.Config{AuthDir: t.TempDir()}, nil)
+	router := gin.New()
+	router.GET("/auth", handler.StartOAuthV8)
+	response := httptest.NewRecorder()
+	router.ServeHTTP(response, httptest.NewRequest(http.MethodGet, "/auth?provider=codex&flow=device", nil))
+	if response.Code != 200 {
+		t.Fatalf("status %d: %s", response.Code, response.Body.String())
+	}
+	var result struct {
+		State, Flow, URL string
+		UserCode         string `json:"user_code"`
+		ExpiresIn        int    `json:"expires_in"`
+	}
+	if err := json.Unmarshal(response.Body.Bytes(), &result); err != nil {
+		t.Fatal(err)
+	}
+	if result.Flow != "device" || result.UserCode != "ABCD-EFGH" || result.ExpiresIn != 900 || result.URL != "https://auth.openai.com/codex/device" {
+		t.Fatalf("unexpected response: %+v", result)
+	}
+	if strings.Contains(response.Body.String(), "secret-device-id") {
+		t.Fatal("leaked device secret")
+	}
+	<-polling
+	if !CancelOAuthSession(result.State) {
+		t.Fatal("session not cancelled")
+	}
+	select {
+	case <-cancelled:
+	case <-time.After(time.Second):
+		t.Fatal("device polling was not stopped")
+	}
+}
+
+func TestDeviceCompletionAndCancellationAreExclusive(t *testing.T) {
+	store := newOAuthSessionStore(time.Minute)
+	store.Register("cancelled", "codex")
+	ctx, cancel := context.WithCancel(context.Background())
+	store.attachCancel("cancelled", cancel)
+	if !store.Cancel("cancelled") || ctx.Err() == nil {
+		t.Fatal("cancel did not interrupt login")
+	}
+	saved := false
+	if err := store.finishOAuth("cancelled", func() error { saved = true; return nil }); err != errOAuthSessionNotPending || saved {
+		t.Fatal("cancelled flow saved credentials")
+	}
+	store.Register("completed", "codex")
+	if err := store.finishOAuth("completed", func() error { saved = true; return nil }); err != nil || !saved {
+		t.Fatal("completion failed")
+	}
+	if store.Cancel("completed") {
+		t.Fatal("completed flow was cancelled")
+	}
+}
+
+func TestCodexDeviceManagementPersistsCredential(t *testing.T) {
+	old := http.DefaultTransport
+	defer func() { http.DefaultTransport = old }()
+	jwt := "e30." + base64.RawURLEncoding.EncodeToString([]byte(`{"email":"device@example.test","https://api.openai.com/auth":{"chatgpt_account_id":"account","chatgpt_plan_type":"pro"}}`)) + ".signature"
+	http.DefaultTransport = deviceTransport(func(r *http.Request) (*http.Response, error) {
+		var body string
+		switch r.URL.Path {
+		case "/api/accounts/deviceauth/usercode":
+			body = `{"device_auth_id":"private","user_code":"ABCD","interval":1}`
+		case "/api/accounts/deviceauth/token":
+			body = `{"authorization_code":"code","code_verifier":"verifier","code_challenge":"challenge"}`
+		case "/oauth/token":
+			if err := r.ParseForm(); err != nil {
+				t.Error(err)
+			}
+			if r.Form.Get("redirect_uri") != "https://auth.openai.com/deviceauth/callback" {
+				t.Error("wrong device callback")
+			}
+			encoded, _ := json.Marshal(map[string]any{"access_token": "access", "refresh_token": "refresh", "expires_in": 3600, "id_token": jwt})
+			body = string(encoded)
+		default:
+			t.Errorf("unexpected request: %s", r.URL)
+			body = `{}`
+		}
+		return &http.Response{StatusCode: 200, Body: io.NopCloser(strings.NewReader(body)), Header: make(http.Header)}, nil
+	})
+	directory := t.TempDir()
+	handler := NewHandlerWithoutConfigFilePath(&config.Config{AuthDir: directory}, nil)
+	persisted := make(chan struct{})
+	handler.postAuthPersistHook = func(_ context.Context, _ *coreauth.Auth) error { close(persisted); return nil }
+	router := gin.New()
+	router.GET("/auth", handler.StartOAuthV8)
+	response := httptest.NewRecorder()
+	router.ServeHTTP(response, httptest.NewRequest(http.MethodGet, "/auth?provider=codex&flow=device", nil))
+	if response.Code != 200 {
+		t.Fatalf("status %d: %s", response.Code, response.Body.String())
+	}
+	var result struct{ State string }
+	_ = json.Unmarshal(response.Body.Bytes(), &result)
+	select {
+	case <-persisted:
+	case <-time.After(time.Second):
+		t.Fatal("credential was not persisted")
+	}
+	session, ok := oauthSessions.Get(result.State)
+	if !ok || !session.Completed {
+		t.Fatal("device flow not completed")
+	}
+	files, err := filepath.Glob(filepath.Join(directory, "*.json"))
+	if err != nil || len(files) != 1 {
+		t.Fatalf("files: %v, %v", files, err)
+	}
+	data, err := os.ReadFile(files[0])
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !strings.Contains(string(data), "device@example.test") {
+		t.Fatal("saved wrong account")
+	}
+}
