diff --git a/sdk/api/handlers/openai/t3_model_modalities_test.go b/sdk/api/handlers/openai/t3_model_modalities_test.go
new file mode 100644
index 0000000..3e29b01
--- /dev/null
+++ b/sdk/api/handlers/openai/t3_model_modalities_test.go
@@ -0,0 +1,70 @@
+package openai
+
+import (
+	"encoding/json"
+	"net/http/httptest"
+	"reflect"
+	"strings"
+	"testing"
+
+	"github.com/gin-gonic/gin"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/config"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/registry"
+	"github.com/router-for-me/CLIProxyAPI/v8/sdk/api/handlers"
+)
+
+func TestT3ModelsPreserveKnownModalities(t *testing.T) {
+	r := registry.GetGlobalRegistry()
+	client := "t3-modalities-test"
+	r.RegisterClient(client, "openai-compatibility", registry.WithCodexBuiltins([]*registry.ModelInfo{
+		{ID: "t3-image-model", SupportedInputModalities: []string{"text", "image"}, SupportedOutputModalities: []string{"text", "image"}},
+		{ID: "t3-unknown-model"},
+	}))
+	t.Cleanup(func() { r.UnregisterClient(client) })
+	handler := NewOpenAIAPIHandler(handlers.NewBaseAPIHandlers(&config.SDKConfig{}, nil))
+	response := httptest.NewRecorder()
+	ctx, _ := gin.CreateTestContext(response)
+	ctx.Request = httptest.NewRequest("GET", "/v1/models", nil)
+	handler.OpenAIModels(ctx)
+	if response.Code != 200 {
+		t.Fatalf("status %d: %s", response.Code, response.Body.String())
+	}
+	var result struct {
+		Data []struct {
+			ID     string   `json:"id"`
+			Input  []string `json:"supported_input_modalities"`
+			Output []string `json:"supported_output_modalities"`
+		} `json:"data"`
+	}
+	if err := json.Unmarshal(response.Body.Bytes(), &result); err != nil {
+		t.Fatal(err)
+	}
+	seen := false
+	imageModels := 0
+	for _, model := range result.Data {
+		if model.ID == "t3-image-model" {
+			seen = true
+			if !reflect.DeepEqual(model.Input, []string{"text", "image"}) {
+				t.Fatalf("image support lost: %v", model.Input)
+			}
+		}
+		if strings.HasPrefix(model.ID, "gpt-image-") {
+			imageModels++
+			if !reflect.DeepEqual(model.Output, []string{"image"}) {
+				t.Fatalf("image-only output lost for %s: %v", model.ID, model.Output)
+			}
+		}
+		if model.ID == "t3-image-model" && !reflect.DeepEqual(model.Output, []string{"text", "image"}) {
+			t.Fatalf("mixed output lost: %v", model.Output)
+		}
+		if model.ID == "t3-unknown-model" && (len(model.Input) != 0 || len(model.Output) != 0) {
+			t.Fatalf("invented modalities: %v", model.Input)
+		}
+	}
+	if imageModels != 5 {
+		t.Fatalf("image model count = %d, want 5", imageModels)
+	}
+	if !seen {
+		t.Fatal("missing image model")
+	}
+}
