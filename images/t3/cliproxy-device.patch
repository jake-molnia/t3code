@@ -0,0 +1,70 @@
+package management
+
+import (
+	"context"
+	"net/http"
+	"time"
+
+	"github.com/gin-gonic/gin"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/misc"
+	sdkAuth "github.com/router-for-me/CLIProxyAPI/v8/sdk/auth"
+)
+
+// RequestCodexDeviceToken exposes the SDK device flow without a local browser or callback listener.
+func (h *Handler) RequestCodexDeviceToken(c *gin.Context) {
+	state, err := misc.GenerateRandomState()
+	if err != nil {
+		c.JSON(http.StatusInternalServerError, gin.H{"error": "failed to create device session"})
+		return
+	}
+	ctx, cancel := context.WithTimeout(PopulateAuthContext(context.Background(), c), 15*time.Minute)
+	RegisterOAuthSession(state, "codex")
+	oauthSessions.attachCancel(state, cancel)
+	ready := make(chan sdkAuth.DeviceAuthorization, 1)
+	done := make(chan error, 1)
+	go func() {
+		defer cancel()
+		record, err := sdkAuth.NewCodexAuthenticator().Login(ctx, h.cfg, &sdkAuth.LoginOptions{
+			NoBrowser: true,
+			Metadata:  map[string]string{"codex_login_mode": "device"},
+			DeviceAuthorization: func(code sdkAuth.DeviceAuthorization) error {
+				select {
+				case ready <- code:
+					return nil
+				case <-ctx.Done():
+					return ctx.Err()
+				}
+			},
+		})
+		if err == nil {
+			_, err = h.saveOAuthTokenRecord(ctx, state, record)
+		}
+		if err != nil {
+			SetOAuthSessionError(state, "Device authentication failed")
+		}
+		done <- err
+	}()
+	timer := time.NewTimer(12 * time.Second)
+	defer timer.Stop()
+	respond := func(code sdkAuth.DeviceAuthorization) {
+		c.JSON(http.StatusOK, gin.H{"status": "ok", "flow": "device", "state": state, "url": code.URL, "user_code": code.UserCode, "expires_in": code.ExpiresIn})
+	}
+	select {
+	case code := <-ready:
+		respond(code)
+	case <-done:
+		select {
+		case code := <-ready:
+			respond(code)
+			return
+		default:
+		}
+		CancelOAuthSession(state)
+		c.JSON(http.StatusBadGateway, gin.H{"error": "device authorization unavailable"})
+	case <-timer.C:
+		CancelOAuthSession(state)
+		c.JSON(http.StatusGatewayTimeout, gin.H{"error": "device authorization timed out"})
+	case <-c.Request.Context().Done():
+		CancelOAuthSession(state)
+	}
+}
