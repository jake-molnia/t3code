diff --git a/internal/api/handlers/management/auth_files_oauth_save.go b/internal/api/handlers/management/auth_files_oauth_save.go
new file mode 100644
index 0000000..a97195e
--- /dev/null
+++ b/internal/api/handlers/management/auth_files_oauth_save.go
@@ -0,0 +1,35 @@
+package management
+
+import (
+	"context"
+	"errors"
+
+	coreauth "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/auth"
+	log "github.com/sirupsen/logrus"
+)
+
+// authCommitFollowupError records failure after Store.Save acknowledged persistence.
+// It preserves the existing error for non-OAuth callers while identifying the commit boundary.
+type authCommitFollowupError struct {
+	stage string
+	cause error
+}
+
+func (e *authCommitFollowupError) Error() string { return e.cause.Error() }
+func (e *authCommitFollowupError) Unwrap() error { return e.cause }
+
+// saveOAuthTokenRecord commits credentials and session completion together with respect to cancellation.
+func (h *Handler) saveOAuthTokenRecord(ctx context.Context, state string, record *coreauth.Auth) (string, error) {
+	var path string
+	err := oauthSessions.finishOAuth(state, func() error {
+		var err error
+		path, err = h.saveTokenRecord(ctx, record)
+		var followup *authCommitFollowupError
+		if errors.As(err, &followup) {
+			log.WithField("stage", followup.stage).Warn("OAuth credentials saved; post-save synchronization failed")
+			return nil
+		}
+		return err
+	})
+	return path, err
+}
diff --git a/internal/api/handlers/management/auth_files_oauth_save_test.go b/internal/api/handlers/management/auth_files_oauth_save_test.go
