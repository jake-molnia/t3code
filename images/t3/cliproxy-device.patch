index 0000000..521d2ac
--- /dev/null
+++ b/internal/api/handlers/management/auth_files_oauth_save_test.go
@@ -0,0 +1,147 @@
+package management
+
+import (
+	"context"
+	"errors"
+	"os"
+	"testing"
+	"time"
+
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/config"
+	sdkAuth "github.com/router-for-me/CLIProxyAPI/v8/sdk/auth"
+	coreauth "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/auth"
+)
+
+func TestOAuthSaveCancellationIsAtomic(t *testing.T) {
+	for _, provider := range []string{"codex", "anthropic", "antigravity", "kimi", "kimi-ai", "xai", "devin", "meta"} {
+		t.Run(provider, func(t *testing.T) {
+			directory := t.TempDir()
+			h := NewHandlerWithoutConfigFilePath(&config.Config{AuthDir: directory}, nil)
+			h.tokenStore = sdkAuth.NewFileTokenStore()
+			record := &coreauth.Auth{ID: "account.json", FileName: "account.json", Provider: provider, Metadata: map[string]any{"access_token": "test"}}
+			state := "save-cancel-" + provider
+			RegisterOAuthSession(state, provider)
+			if !CancelOAuthSession(state) {
+				t.Fatal("cancel failed")
+			}
+			if _, err := h.saveOAuthTokenRecord(context.Background(), state, record); !errors.Is(err, errOAuthSessionNotPending) {
+				t.Fatalf("cancelled save: %v", err)
+			}
+			files, err := os.ReadDir(directory)
+			if err != nil || len(files) != 0 {
+				t.Fatal("cancelled flow wrote credentials")
+			}
+
+			RegisterOAuthSession(state, provider)
+			saving := make(chan struct{})
+			release := make(chan struct{})
+			h.postAuthHook = func(context.Context, *coreauth.Auth) error { close(saving); <-release; return nil }
+			saved := make(chan error, 1)
+			go func() { _, err := h.saveOAuthTokenRecord(context.Background(), state, record); saved <- err }()
+			<-saving
+			cancellation := make(chan bool, 1)
+			attempted := make(chan struct{})
+			go func() { close(attempted); cancellation <- CancelOAuthSession(state) }()
+			<-attempted
+			close(release)
+			select {
+			case err := <-saved:
+				if err != nil {
+					t.Fatal(err)
+				}
+			case <-time.After(time.Second):
+				t.Fatal("save deadlocked")
+			}
+			select {
+			case cancelled := <-cancellation:
+				if cancelled {
+					t.Fatal("cancel reported success after credential commit")
+				}
+			case <-time.After(time.Second):
+				t.Fatal("cancel deadlocked")
+			}
+			session, ok := oauthSessions.Get(state)
+			if !ok || !session.Completed {
+				t.Fatal("saved account has no completed session")
+			}
+			if _, err := os.Stat(directory + "/account.json"); err != nil {
+				t.Fatal(err)
+			}
+		})
+	}
+}
+
+func TestOAuthSavePostPersistFailureKeepsCommittedOutcome(t *testing.T) {
+	directory := t.TempDir()
+	h := NewHandlerWithoutConfigFilePath(&config.Config{AuthDir: directory}, nil)
+	h.tokenStore = sdkAuth.NewFileTokenStore()
+	record := &coreauth.Auth{ID: "account.json", FileName: "account.json", Provider: "codex", Metadata: map[string]any{"type": "codex", "access_token": "test"}}
+	var hooked *coreauth.Auth
+	h.postAuthPersistHook = func(_ context.Context, auth *coreauth.Auth) error {
+		hooked = auth.Clone()
+		return errors.New("private-hook-error")
+	}
+	state := "saved-with-hook-error"
+	RegisterOAuthSession(state, "codex")
+	path, err := h.saveOAuthTokenRecord(context.Background(), state, record)
+	if err != nil {
+		t.Fatalf("durably saved login reported failure: %v", err)
+	}
+	if _, err := os.Stat(path); err != nil {
+		t.Fatal(err)
+	}
+	if hooked == nil || hooked.ID != record.ID || hooked.Attributes[coreauth.AttributePath] != path || hooked.Attributes[coreauth.AttributeSourceBackend] != coreauth.AuthSourceFile {
+		t.Fatalf("post-save synchronization did not receive the canonical source identity: %#v", hooked)
+	}
+	session, ok := oauthSessions.Get(state)
+	if !ok || !session.Completed {
+		t.Fatal("saved credential must have a completed login")
+	}
+	SetOAuthSessionError(state, "late failure")
+	session, _ = oauthSessions.Get(state)
+	if session.Status != "" || !session.Completed {
+		t.Fatal("late error replaced committed outcome")
+	}
+	if CancelOAuthSession(state) {
+		t.Fatal("cancellation won after credential commit")
+	}
+}
+
+type failingOAuthTokenStore struct{ coreauth.Store }
+
+func (s failingOAuthTokenStore) Save(context.Context, *coreauth.Auth) (string, error) {
+	// A store's error is authoritative even when it returns a nonempty diagnostic path.
+	return "/not-persisted/account.json", errors.New("store-failure")
+}
+
+func TestOAuthSaveBeforeCommitFailureRemainsRejected(t *testing.T) {
+	for _, stage := range []string{"pre-save-hook", "store"} {
+		t.Run(stage, func(t *testing.T) {
+			directory := t.TempDir()
+			h := NewHandlerWithoutConfigFilePath(&config.Config{AuthDir: directory}, nil)
+			h.tokenStore = sdkAuth.NewFileTokenStore()
+			if stage == "pre-save-hook" {
+				h.postAuthHook = func(context.Context, *coreauth.Auth) error { return errors.New("hook-failure") }
+			} else {
+				h.tokenStore = failingOAuthTokenStore{Store: h.tokenStore}
+			}
+			record := &coreauth.Auth{ID: "account.json", FileName: "account.json", Provider: "codex", Metadata: map[string]any{"type": "codex", "access_token": "test"}}
+			state := "not-saved-" + stage
+			RegisterOAuthSession(state, "codex")
+			if _, err := h.saveOAuthTokenRecord(context.Background(), state, record); err == nil {
+				t.Fatal("pre-commit failure was swallowed")
+			}
+			files, err := os.ReadDir(directory)
+			if err != nil || len(files) != 0 {
+				t.Fatal("failed save left credentials")
+			}
+			session, ok := oauthSessions.Get(state)
+			if !ok || session.Completed {
+				t.Fatal("failed save marked enrollment completed")
+			}
+			if !CancelOAuthSession(state) {
+				t.Fatal("failed save prevented cancellation")
+			}
+		})
+	}
+}
