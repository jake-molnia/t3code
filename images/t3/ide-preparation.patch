+// Serialize the preparation check and launch claim with the worker's pause request.
+// A pause can then wait for running to disappear without racing a not-yet-started child.
+func claimPreparedIDE(receipt, status string) (bool, error) {
+	lock, err := os.OpenFile(filepath.Join(filepath.Dir(receipt), "control.lock"), os.O_CREATE|os.O_RDWR, 0600)
+	if err != nil {
+		return false, err
+	}
+	defer lock.Close()
+	if err = syscall.Flock(int(lock.Fd()), syscall.LOCK_EX); err != nil {
+		return false, err
+	}
+	defer syscall.Flock(int(lock.Fd()), syscall.LOCK_UN)
+	if _, err = os.Stat(receipt); os.IsNotExist(err) {
+		return false, nil
+	}
+	if err != nil {
+		return false, err
+	}
+	if err = os.WriteFile(status, []byte("starting"), 0600); err != nil {
+		return false, err
+	}
+	return true, nil
+}
