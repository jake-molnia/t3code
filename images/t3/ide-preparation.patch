+func TestT3IDEPreparationClaimPrecedesLaunch(t *testing.T) {
+	root := t.TempDir()
+	receipt, status := filepath.Join(root, "prepared"), filepath.Join(root, "running")
+	ready, err := claimPreparedIDE(receipt, status)
+	if err != nil || ready {
+		t.Fatalf("unprepared editor claimed: %v %v", ready, err)
+	}
+	if _, err := os.Stat(status); !os.IsNotExist(err) {
+		t.Fatal("unprepared editor published a running status")
+	}
+	if err := os.WriteFile(receipt, []byte("prepared"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	ready, err = claimPreparedIDE(receipt, status)
+	if err != nil || !ready {
+		t.Fatalf("prepared editor not claimed: %v %v", ready, err)
+	}
+	contents, err := os.ReadFile(status)
+	if err != nil || string(contents) != "starting" {
+		t.Fatal("launch claim is not visible before spawning the child")
+	}
+}
