# Optional existing Clerk account integration for source builds.
# These public identifiers are not server-side secrets. Browser pairing and
# provider account authentication do not require deploying a T3 Connect relay.
T3CODE_CLERK_PUBLISHABLE_KEY=pk_live_Y2xlcmsudDMuY29kZXMk
T3CODE_CLERK_JWT_TEMPLATE=t3-relay
T3CODE_RELAY_URL=https://relay.t3.codes

# Canonical address for webhook URLs returned to agents and the browser.
# Configure this on the central service, then restart it. Include any proxy path
# prefix; the proxy must strip it when forwarding to the service.
# T3CODE_PUBLIC_URL=https://t3.example.com
